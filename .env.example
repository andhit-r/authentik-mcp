# ============================================================================
# Konfigurasi authentik-mcp
# Salin file ini menjadi `.env` lalu isi nilai yang sesuai.
# JANGAN pernah commit file `.env` yang berisi credential asli.
# ============================================================================

# ---------------------------------------------------------------------------
# Koneksi ke Authentik REST API (WAJIB)
# ---------------------------------------------------------------------------
# URL dasar instance Authentik (tanpa trailing slash, tanpa /api/v3).
AUTHENTIK_URL=https://auth.yourdomain.com

# API Token Authentik. Buat di:
#   Admin Interface -> Directory -> Tokens & App passwords
# Token ini dikirim sebagai header: Authorization: Bearer <AUTHENTIK_API_TOKEN>
# Dipakai server untuk SEMUA panggilan tool ke Authentik API (server-side).
AUTHENTIK_API_TOKEN=your-api-token

# Timeout (detik) untuk setiap request ke Authentik API. Opsional.
AUTHENTIK_TIMEOUT=30

# Verifikasi sertifikat TLS saat memanggil Authentik API (true/false). Opsional.
AUTHENTIK_VERIFY_SSL=true

# ---------------------------------------------------------------------------
# Login via Authentik (OAuth Proxy + Dynamic Client Registration) — DISARANKAN
# ---------------------------------------------------------------------------
# Dengan mode ini, pengguna TIDAK perlu mengisi client id/secret di Claude.
# Claude mendaftar otomatis (DCR) dan pengguna cukup LOGIN di Authentik.
# OAUTH_CLIENT_ID / OAUTH_CLIENT_SECRET berada di sisi server (file .env ini),
# dibuat sekali oleh admin di Authentik (OAuth2/OpenID Provider).
#
# Syarat di Authentik:
#   - Buat OAuth2/OpenID Provider + Application untuk MCP ini.
#   - Redirect URI provider diarahkan ke:  <MCP_BASE_URL>/auth/callback
#
# Mode OAuth Proxy AKTIF bila OAUTH_CLIENT_ID, OAUTH_CLIENT_SECRET, domain publik
# Authentik (dari OAUTH_OIDC_CONFIG_URL atau AUTHENTIK_OAUTH_DOMAIN), slug
# provider, dan MCP_BASE_URL terisi.
OAUTH_CLIENT_ID=your-oauth-client-id
OAUTH_CLIENT_SECRET=your-oauth-client-secret

# OIDC discovery URL provider Authentik. Bila diisi, domain publik dan slug
# provider akan di-derive otomatis dari sini (sehingga AUTHENTIK_OAUTH_DOMAIN
# dan AUTHENTIK_APP_SLUG boleh dikosongkan).
# Format: https://<authentik-domain>/application/o/<provider-slug>/.well-known/openid-configuration
OAUTH_OIDC_CONFIG_URL=https://auth.yourdomain.com/application/o/authentik-mcp/.well-known/openid-configuration

# (Opsional) Override eksplisit bila tidak memakai OAUTH_OIDC_CONFIG_URL.
# AUTHENTIK_OAUTH_DOMAIN: URL publik (browser-facing) Authentik.
#   Contoh: https://auth.yourdomain.com
# AUTHENTIK_APP_SLUG: slug OAuth2/OIDC Provider di Authentik.
#   Contoh: authentik-mcp
AUTHENTIK_OAUTH_DOMAIN=
AUTHENTIK_APP_SLUG=

# Daftar username Authentik yang diizinkan login (dipisah koma).
# Kosongkan untuk mengizinkan SEMUA user yang berhasil login di Authentik.
# Contoh: andhit-r,user2
AUTHENTIK_ALLOWED_USERNAMES=

# Scope yang diminta saat login (dipisah spasi). Opsional.
# Default bila kosong: "openid profile email".
OAUTH_REQUIRED_SCOPES=

# ---------------------------------------------------------------------------
# Kompatibilitas mundur: Introspection (RFC 7662)
# ---------------------------------------------------------------------------
# Hanya dipakai bila mode OAuth Proxy di atas TIDAK lengkap. Memvalidasi Bearer
# token yang sudah dipegang client (bukan alur login Claude). Opsional.
OAUTH_INTROSPECTION_URL=

# TTL (detik) cache hasil introspeksi token. 0 = nonaktif (default). Opsional.
OAUTH_CACHE_TTL=0

# (Opsional) URL internal OIDC discovery untuk fetch konfigurasi dari dalam
# Docker (hindari resolusi DNS publik). Tidak diiklankan ke client.
# Contoh: http://server:9000/application/o/authentik-mcp/.well-known/openid-configuration
OAUTH_OIDC_CONFIG_URL_INTERNAL=

# ---------------------------------------------------------------------------
# Konfigurasi runtime MCP server
# ---------------------------------------------------------------------------
# Transport: "http" (default, untuk remote/Claude.ai) atau "stdio" (lokal).
MCP_TRANSPORT=http

# URL publik MCP server ini. WAJIB diisi agar login via Authentik (OAuth Proxy)
# berfungsi — dipakai untuk OAuth metadata & redirect callback.
# Contoh: https://mcp.yourdomain.com
MCP_BASE_URL=

# Host & port saat transport=http.
MCP_HOST=0.0.0.0
MCP_PORT=8000

# Level log: DEBUG, INFO, WARNING, ERROR.
MCP_LOG_LEVEL=INFO
